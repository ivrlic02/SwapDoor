# Copy this file to .env.local and fill in your Supabase project values.
# Found in: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: the site's public URL, used to turn app/opengraph-image.png into the
# absolute URL social platforms need. Only set this for a custom domain — on
# Vercel the production domain is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://swapdoor.example.com
